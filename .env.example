# Copy this file to .env and replace every placeholder. Never commit .env.
# docker compose reads .env for variable substitution, and the application imports it
# (spring.config.import=optional:file:.env[.properties]) when started from this directory.

# PostgreSQL
POSTGRES_DB=payment_db
POSTGRES_USER=payment_user
POSTGRES_PASSWORD=change-me-postgres-password
# Host port for PostgreSQL (change it if 5432 is already in use)
POSTGRES_HOST_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/payment_db

# Redis
REDIS_PASSWORD=change-me-redis-password
# Host port for Redis (change it if 6379 is already in use)
REDIS_HOST_PORT=6379
REDIS_HOST=localhost
REDIS_PORT=6379

# API client (X-API-Key header). The key must be at least 32 random characters. Instead of the
# plain key you may set APP_CLIENT_API_KEY_SHA256 to its hex SHA-256 digest (set exactly one).
# Generate a key with: openssl rand -hex 32
APP_CLIENT_NAME=default-client
APP_CLIENT_API_KEY=replace-with-at-least-32-random-characters-client
APP_CLIENT_API_KEY_SHA256=
# Comma-separated ledger accounts this client may create and read payouts for. Nothing is implied.
APP_CLIENT_ACCOUNTS=user_123

# Admin key: operations endpoints (ledger, DLQ, metrics, health details). It cannot create payouts
# or read payouts unless granted below.
APP_ADMIN_API_KEY=replace-with-at-least-32-random-characters-admin
APP_ADMIN_API_KEY_SHA256=
APP_ADMIN_ACCOUNTS=
APP_ADMIN_READ_ALL_PAYOUTS=false

# Treasury keys (optional; treasury is disabled while these are empty). They request, approve and
# reject funding adjustments and resolve payouts in manual review for their accounts. By default an
# adjustment needs approval from a second, different treasury key, so configure two for funding.
APP_TREASURY_1_NAME=treasury-1
APP_TREASURY_1_API_KEY=
APP_TREASURY_1_ACCOUNTS=
APP_TREASURY_2_NAME=treasury-2
APP_TREASURY_2_API_KEY=
APP_TREASURY_2_ACCOUNTS=

# Required. "local" permits development-only features (dev profile, ledger seeding, loggers endpoint).
# "production" refuses them and every safety-reducing setting. Any other value, or leaving it unset,
# refuses development-only features.
APP_ENVIRONMENT=local

# Database connection pool size (worker concurrency + HTTP threads compete for it).
DB_POOL_SIZE=20

# Import balances from the pre-V4 Redis ledger at startup (idempotent; safe to leave on).
LEDGER_REDIS_IMPORT_ENABLED=true

# Spring profile for the containerised app (docker compose --profile app). Set "dev" for the local
# demo: it registers the ledger seeding endpoint, without which no test account can be created
# (requires APP_ENVIRONMENT=local). Leave empty everywhere else. A value exported in your shell
# overrides this file when you run docker compose.
SPRING_PROFILES_ACTIVE=
